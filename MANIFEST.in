graft third_party/cminpack
graft third_party/pyeto
include src/smew/equations.pxd
include src/smew/_native/_minpack.pyx
include Makefile
recursive-include tests *.py *.toml
include tests/README.md
include docs/conf.py
include notebooks/Example.ipynb
recursive-include docs *.rst *.ipynb *.css
include docs/_static/SMEW_logo.png
prune docs/_build
prune docs/_generated
prune docs/diagrams
prune build
global-exclude __pycache__ *.py[cod] *.so *.pyd *.nbc *.nbi
